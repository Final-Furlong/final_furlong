/# locals: (horse:)
- record = horse.annual_race_records.current_year.order(year: :asc).first
tr
  td class="text-#{horse.gender}" = link_to horse.name_with_title, horse_path(horse), target: "_top"
  td= record.overall_string
  td
    - if Racing::BreedersCupPotentialEntry.exists? && false
      - Racing::BreedersCupPotentialEntry.max_rank.joins(:horse, :race).includes(:race).where(horse:).order(rank: :asc).each do |entry|
        p= t(".qualification", race: entry.race.name, rank: entry.rank)
    - else
     - horse.breeders_cup_potential_races.each do |race_string|
       - if (qualification = horse.send("breeders_cup_#{race_string}_qualification"))
         ruby:
           klass = qualification.class
           better_ranked = klass.nominated.better_ranked(qualification).count
           rank = better_ranked + 1
           tied = klass.nominated.identically_ranked(qualification).count - 1
         p
           = race_string.humanize.titleize.gsub("Sc ", "SC ")
           = " - "
           = qualification.record_string
           span= " - Rank #{rank}"
           - if tied.positive?
             = " (#{t("racing.breeders_cup_qualifiers.qualifier.tied_count", count: tied)})"
