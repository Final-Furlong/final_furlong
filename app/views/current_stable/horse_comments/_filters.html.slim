/# locals: (query:)
= turbo_search_form_for query, url: stable_horse_comments_path, method: :get, turbo_frame: "horse-comments-list" do |f|
  .collapse.collapse-arrow.bg-base-100.border-base-content/50.border.border-1
    input type="checkbox"
    .collapse-title.font-semibold.font-medium= t("common.filters")
    .collapse-content.text-sm.border-t-1.border-base-content/40
      .grid.grid-cols-1.sm:grid-cols-4.lg:grid-cols-6.mb-2.gap-4
        div
          fieldset.fieldset
            legend.fieldset-legend= t(".horse")
            = f.text_field :name_i_cont, class: 'input', type: 'text'
        div
          fieldset.fieldset
            legend.fieldset-legend= t(".comment")
            = f.text_field :comments_title_or_comments_comment_i_cont, class: 'input', type: 'text'

      .float-right.mt-2
        = render Ui::ButtonizedLink::Component.new(url: stable_horse_comments_path, color: :error, style: :outline, size: :small, extra_classes: "me-2", http_method: :get, data: { turbo: false }) do
          = t("common.search_form.reset_filters")
        = render Ui::SubmitButton::Component.new(form: f, size: :small, extra_classes: "d-lg-none", text: t("common.search_form.action"))
