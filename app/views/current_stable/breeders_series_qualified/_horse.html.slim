/# locals: (horse:)
- record = horse.annual_race_records.current_year.order(year: :asc).first
tr
  td class="text-#{horse.gender}" = link_to horse.name_with_title, horse_path(horse), target: "_top"
  td= record.overall_string
  td
    - Racing::BreedersSeriesPotentialEntry.max_rank.joins(:horse, :first_race).includes(:first_race).where(horse:).order(rank: :asc).each do |entry|
      p= t(".qualification", series: entry.first_race.breeders_series_name, rank: entry.rank)
